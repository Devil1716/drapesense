{
  "name": "drapesense",
  "version": "1.0.4",
  "private": true,
  "description": "DrapeSense fabric scanner app",
  "scripts": {
    "serve": "python -m http.server 8080",
    "prepare:web": "node scripts/prepare-web.js",
    "cap:sync": "npm run prepare:web && cap sync android",
    "apk:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  }
}
